# Laisser désactivé tant que la protection distante n’est pas vérifiée.
VOICEBOT_VOIX_ACTIVE=false

# Mode démo sans code : seule la valeur exacte true ouvre l’accès public.
# Conserver false pour le fonctionnement protégé habituel.
VOICEBOT_ACCES_PUBLIC=false

# Valeurs à renseigner uniquement dans l’environnement serveur.
# Ne jamais donner à un secret un préfixe VITE_ : il serait exposé au navigateur.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICEBOT_CODE_ACCES_SHA256=

# Origine exacte, sans chemin ni barre finale ; adapter au port réellement utilisé.
VOICEBOT_ORIGINE=http://localhost:3000
